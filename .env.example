APP_NAME="Nexo Links"
APP_ENV=local
# Timezone used for link scheduling, e.g. America/Argentina/Buenos_Aires
# APP_TIMEZONE=UTC
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. The values below target the shared local Docker stack `nexo`
# (MySQL on host port 3307); this repo's compose.yaml only runs the app runtime,
# so the database is reached through host.docker.internal.
# SELF-HOSTING: point these at your own MySQL — see DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=nexo
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Unique per tool so every Nexo app can run at once (map in dev-environment).
APP_PORT=8090
VITE_PORT=5174

# Nexo ecosystem chrome. This tool's key (marks itself in the app-switcher);
# leave as-is unless self-hosting a renamed fork. The hub/GitHub/tool URLs are
# overridable in config/nexo-ecosystem.php for self-hosters running their own.
NEXO_ECOSYSTEM_CURRENT=nexolinks

# Cookieless ecosystem analytics (opt-in). Off by default; when true, an
# anonymous pageview beacon is sent to the Nexo Tools hub. See config/nexo.php.
NEXO_BEACON_ENABLED=false

# Canonical powered-by attribution (same NEXO_ATTRIBUTION_* name/shape across the
# whole ecosystem). Shown on public pages and in the shared footer.
# NEXO_ATTRIBUTION_LABEL="made with Nexo Links"
# NEXO_ATTRIBUTION_URL="https://alvarocdev.com"

# Help center "contact us" target. A support URL wins; else mailto: the email.
# NEXO_SUPPORT_URL=
# NEXO_SUPPORT_EMAIL="hola@alvarocdev.com"

# Nexo ID SSO (optional). Off by default: the app runs standalone with local
# accounts. Enable to add a "Continue with Nexo ID" login against a Nexo ID
# instance (OIDC + PKCE). Register the client on the provider with an exact
# redirect of {APP_URL}/auth/nexo/callback (php artisan nexo:sso-client).
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=
# Silent SSO (prompt=none) rides NEXO_SSO_ENABLED; set false to kill-switch it per tool.
NEXO_SSO_SILENT=true
# Where Nexo ID returns the browser after a central (RP-initiated) logout. Register
# this exact URI on the provider or it lands on Nexo ID's own "signed out" page.
NEXO_SSO_POST_LOGOUT_REDIRECT_URI=https://nexolinks.alvarocdev.com

# Who runs this instance, named on the legal pages. Unset (default) = the
# "who runs this instance" section is not rendered, so a clone never publishes
# the upstream author's details. Alvaro's instances get these from CI.
# NEXO_LEGAL_OPERATOR="Your name or company"
# NEXO_LEGAL_CONTACT=legal@yourdomain.com
